# SimpleSIP Configuration
# Copy this file to .env and update with your settings

# SIP Server Configuration
SIP_USER=1001
SIP_PASSWORD=password
SIP_SERVER=192.168.1.5
TARGET_NUMBER=1002

# Local Configuration
LOCAL_IP=192.168.1.20

# TTS Configuration
TTS_ENGINE=turbo
TTS_DEVICE=cuda

# RVC Configuration (optional)
# Set RVC_ENABLED to true to use RVC voice conversion
RVC_ENABLED=false
RVC_MODEL_PATH=
RVC_INDEX_PATH=

# Example RVC paths:
# RVC_MODEL_PATH=/path/to/your/model.pth
# RVC_INDEX_PATH=/path/to/your/index.index
