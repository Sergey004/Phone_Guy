# =============================================================================
# Phone Guy Bot - Environment Configuration Template
# Copy this file to .env and configure your settings
# =============================================================================

HOST_IP=192.168.1.245
# -----------------------------------------------------------------------------
# SIP Telephony Configuration
# -----------------------------------------------------------------------------
SIP_DOMAIN=pbx.example.com          # SIP domain or IP address
SIP_PORT=5060                       # SIP port (default: 5060)
SIP_USER=phoneguy                   # SIP username/extension
SIP_PASSWORD=secret123              # SIP password
SIP_SERVER=pbx.example.com:5060     # SIP server address:port

# Optional: Local SIP testing
# SIP_DOMAIN=127.0.0.1
# SIP_SERVER=127.0.0.1:5060

# -----------------------------------------------------------------------------
# Outbound Calls (Optional)
# -----------------------------------------------------------------------------
# Uncomment and set to make outgoing calls instead of waiting for incoming:
# TARGET_NUMBER=1001

# -----------------------------------------------------------------------------
# NVIDIA LLM Configuration
# -----------------------------------------------------------------------------
NVIDIA_API_KEY=your_key_here        # Your NVIDIA API key from https://build.nvidia.com/
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1  # NVIDIA API endpoint
NVIDIA_MODEL=z-ai/glm4.7            # LLM model to use

# Alternative models:
# NVIDIA_MODEL=meta/llama3-70b-instruct
# NVIDIA_MODEL=meta/llama3-8b-instruct

# -----------------------------------------------------------------------------
# Text-to-Speech Configuration
# -----------------------------------------------------------------------------
TTS_ENGINE=turbo                    # TTS engine: turbo, multilingual, standard
TTS_DEVICE=cuda                     # Device: cuda (GPU) or cpu

# Alternative engines:
# TTS_ENGINE=multilingual           # Supports multiple languages
# TTS_ENGINE=standard               # Standard Chatterbox TTS

# -----------------------------------------------------------------------------
# RVC Voice Conversion (Optional - for voice cloning)
# -----------------------------------------------------------------------------
# Set RVC_ENABLED=false to disable voice conversion
RVC_ENABLED=true

# Path to reference audio file for voice style
# This should be a short WAV clip of the target voice (5-10 seconds)
AUDIO_PROMPT_PATH=ai_core/models/RVC/PhoneGuyFNAF1/PhoneGuy_FNAF1_01.wav

# Path to RVC model file (.pth)
RVC_MODEL_PATH=ai_core/models/RVC/PhoneGuyFNAF1/PhoneGuyFNAF1_e1000_s22000.pth

# Path to RVC index file (.index) - improves voice similarity
RVC_INDEX_PATH=ai_core/models/RVC/PhoneGuyFNAF1/added_IVF339_Flat_nprobe_1_PhoneGuyFNAF1_v2.index

# RVC Parameters
RVC_F0_METHOD=rmvpe                 # F0 detection method: rmvpe, dio, harvest, pm
RVC_PITCH_SHIFT=0                   # Pitch shift in semitones (-12 to +12)
RVC_INDEX_RATE=0.6                  # Index retrieval blend rate (0.0 to 1.0)

# -----------------------------------------------------------------------------
# Example Voice Model Paths (adjust to your model)
# -----------------------------------------------------------------------------
# RVC Voice: Phone Guy (FNAF)
# AUDIO_PROMPT_PATH=ai_core/models/RVC/PhoneGuyFNAF1/PhoneGuy_FNAF1_01.wav
# RVC_MODEL_PATH=ai_core/models/RVC/PhoneGuyFNAF1/PhoneGuyFNAF1_e1000_s22000.pth
# RVC_INDEX_PATH=ai_core/models/RVC/PhoneGuyFNAF1/added_IVF339_Flat_nprobe_1_PhoneGuyFNAF1_v2.index

# Alternative voice models:
# RVC Voice: Glamrock Freddy
# AUDIO_PROMPT_PATH=ai_core/models/RVC/Glamrock_Freddy_v2/reference.wav
# RVC_MODEL_PATH=ai_core/models/RVC/Glamrock_Freddy_v2/Glamrock_Freddy_v2_219e_5475s_best_epoch.pth
# RVC_INDEX_PATH=ai_core/models/RVC/Glamrock_Freddy_v2/Glamrock_Freddy_v2.index

# -----------------------------------------------------------------------------
# Speech-to-Text Configuration (Whisper)
# -----------------------------------------------------------------------------
STT_MODEL=tiny                      # Whisper model size: tiny, base, small, medium, large
STT_DEVICE=cuda                     # Device: cuda (GPU) or cpu
STT_LANGUAGE=en                     # Language code: en, ru, es, etc. (auto if empty)
STT_ENERGY_THRESHOLD=500            # Voice activity detection threshold (100-4000)
STT_SILENCE_END_MS=600              # Silence duration to end utterance (ms)
STT_TARGET_SAMPLE_RATE=16000        # Whisper sample rate (16000 or 24000)
STT_COMPUTE_TYPE=float16            # int8 (CPU) or float16 (GPU)
STT_BEAM_SIZE=5                     # Beam size for decoding (higher = more accurate)
STT_TRANSLATE=False                 # Enable translate

# Larger Whisper models (medium, large) are more accurate but slower:
# STT_MODEL=medium
# STT_MODEL=large

# -----------------------------------------------------------------------------
# Call Logging
# -----------------------------------------------------------------------------
# Logs are saved to logs/ directory automatically
# Each call creates a new file: logs/call_YYYY-MM-DD_HH-MM-SS.txt

# -----------------------------------------------------------------------------
# Knowledge Base (RAG)
# -----------------------------------------------------------------------------
# Documents in knowledge_base/ directory are loaded into vector database
# Supported formats: .txt, .md, .pdf, .doc, .docx
# Vector database is stored in chroma_db/

# -----------------------------------------------------------------------------
# User Memory
# -----------------------------------------------------------------------------
# Call summaries are stored in user_memories/ directory
# Each caller is identified by their phone number
# Memory is used to personalize future conversations
